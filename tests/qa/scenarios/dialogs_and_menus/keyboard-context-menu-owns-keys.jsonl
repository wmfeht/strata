{"scenario":"keyboard-context-menu-owns-keys","modes":["columns","icons","list"],"prefs":{"show_hidden":false,"single_click_previews":false},"layout":"us","mutation":null,"known_bug":null,"setup":[{"fs":{"path":"$data/applications","mkdir":true}},{"fs":{"path":"$data/applications/strata-context-viewer.desktop","write":"[Desktop Entry]\nType=Application\nName=Context Viewer\nExec=true %U\nMimeType=text/plain;text/markdown;\n"}},{"fs":{"path":"$config/mimeapps.list","write":"[Default Applications]\ntext/plain=strata-context-viewer.desktop;\ntext/markdown=strata-context-viewer.desktop;\n[Added Associations]\ntext/plain=strata-context-viewer.desktop;\ntext/markdown=strata-context-viewer.desktop;\n"}},{"fs":{"path":"$config/strata/actions/first-action","mkdir":true,"parents":true}},{"fs":{"path":"$config/strata/actions/first-action/action.toml","write":"schema_version = 1\nid = \"first-action\"\nname = \"First action\"\nmenu = \"submenu\"\n[when]\n[run]\nruntime = \"command\"\nprogram = \"true\"\nargs = [\"{paths}\"]\n"}},{"fs":{"path":"$config/strata/actions/second-action","mkdir":true,"parents":true}},{"fs":{"path":"$config/strata/actions/second-action/action.toml","write":"schema_version = 1\nid = \"second-action\"\nname = \"Second action\"\nmenu = \"submenu\"\n[when]\n[run]\nruntime = \"command\"\nprogram = \"true\"\nargs = [\"{paths}\"]\n"}}],"variants":[{"id":"Menu-Return","vars":{"shortcut":"Menu","activation":"Return"}},{"id":"shift-F10-space","vars":{"shortcut":"shift+F10","activation":"space"}}],"cost":{"columns-Menu-Return":1.0,"icons-Menu-Return":1.0,"list-Menu-Return":1.0,"columns-shift-F10-space":1.0,"icons-shift-F10-space":1.1,"list-shift-F10-space":1.1},"quality":{"impact":3,"coverage":3,"criticality":4,"diagnostic":3,"score":30,"note":"Menu and Shift+F10 open the item menu and ctrl+a/Escape are owned by it; submenu-arrows-return-to-parent covers the arrow navigation, so Menu key and ctrl+a ownership are unique"}}
